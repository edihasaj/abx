#!/usr/bin/env bash
#
# Start/check/stop a separate Chrome profile for agent browser automation.
# This does not touch the user's daily Chrome profile or windows.

set -euo pipefail

CMD="${1:-status}"
PORT="${AGENT_CHROME_PORT:-9223}"
PROFILE_DIR="${AGENT_CHROME_PROFILE_DIR:-$HOME/Projects/farm/browser/chrome-profile}"
CHROME_APP="${CHROME_APP:-/Applications/Google Chrome.app}"
CHROME_BIN="$CHROME_APP/Contents/MacOS/Google Chrome"
CDP_URL="http://127.0.0.1:${PORT}"
PID_FILE="${PROFILE_DIR}/chrome.pid"
LAUNCH_LABEL="com.edihasaj.agent-chrome"
LAUNCH_PLIST="${PROFILE_DIR}/${LAUNCH_LABEL}.plist"

usage() {
  cat <<EOF
chrome-agent — dedicated Chrome profile for agents

Usage: chrome-agent <start|status|stop|url>

Env:
  AGENT_CHROME_PORT         CDP port (default 9223)
  AGENT_CHROME_PROFILE_DIR  profile dir (default ~/Projects/farm/browser/chrome-profile)
  CHROME_APP                Chrome.app path

For abx live against this profile:
  ABX_LIVE_CDP_URL=${CDP_URL} abx live status
EOF
}

endpoint_up() {
  curl -fsS --connect-timeout 1 "${CDP_URL}/json/version" >/dev/null 2>&1
}

launch_job_loaded() {
  launchctl print "gui/$(id -u)/${LAUNCH_LABEL}" >/dev/null 2>&1
}

write_launch_plist() {
  cat >"$LAUNCH_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LAUNCH_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${CHROME_BIN}</string>
    <string>--user-data-dir=${PROFILE_DIR}</string>
    <string>--remote-debugging-port=${PORT}</string>
    <string>--remote-debugging-address=127.0.0.1</string>
    <string>--remote-allow-origins=*</string>
    <string>--no-first-run</string>
    <string>--disable-popup-blocking</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart only when Chrome dies unexpectedly. A clean quit (exit 0) is
       the user closing the window on purpose; respawning there made the
       profile impossible to close. -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>${PROFILE_DIR}/chrome.log</string>
  <key>StandardErrorPath</key><string>${PROFILE_DIR}/chrome.log</string>
</dict>
</plist>
PLIST
}

remove_launch_job() {
  # Two shapes to clear: the bootstrapped LaunchAgent this script writes today,
  # and the `launchctl submit` dynamic job older versions created. `bootout`
  # alone can return before a submitted job disappears (or fail for one),
  # leaving its inferred keepalive policy to reopen Chrome after every quit.
  launchctl remove "$LAUNCH_LABEL" 2>/dev/null || true
  launchctl bootout "gui/$(id -u)/${LAUNCH_LABEL}" 2>/dev/null || true
  for _ in $(seq 1 20); do
    launch_job_loaded || return 0
    sleep 0.1
  done
  return 1
}

case "$CMD" in
  -h|--help|help)
    usage
    ;;

  status)
    echo "chrome-agent: profile=${PROFILE_DIR}"
    echo "chrome-agent: cdp=${CDP_URL}"
    if endpoint_up; then
      echo "ok: agent Chrome CDP is reachable"
      curl -fsS --connect-timeout 1 "${CDP_URL}/json/version" | python3 -m json.tool 2>/dev/null || true
      exit 0
    fi
    echo "fail: agent Chrome CDP is not reachable"
    exit 1
    ;;

  url)
    echo "${CDP_URL}"
    ;;

  start)
    if [ ! -x "$CHROME_BIN" ]; then
      echo "chrome-agent: Chrome binary not found at $CHROME_BIN" >&2
      exit 1
    fi
    if endpoint_up; then
      echo "chrome-agent: already running at ${CDP_URL}"
      exit 0
    fi
    mkdir -p "$PROFILE_DIR"
    echo "chrome-agent: launching dedicated Chrome profile"
    echo "chrome-agent: profile=${PROFILE_DIR}"
    echo "chrome-agent: cdp=${CDP_URL}"
    # A Chrome process launched straight from SSH can be terminated when that
    # session closes. Bootstrap it into the signed-in user's launchd domain
    # instead, so Studio can reliably attach to this dedicated profile after
    # reconnects.
    #
    # Deliberately NOT `launchctl submit`: submitted jobs are KeepAlive
    # unconditionally and cannot be configured otherwise, so quitting the
    # Chrome window relaunched it immediately — the window could not be
    # closed, only the job removed. A bootstrapped plist with
    # KeepAlive.SuccessfulExit=false keeps the crash-restart behaviour while
    # letting a deliberate quit (exit 0) stay quit.
    remove_launch_job || {
      echo "chrome-agent: could not remove the previous launchd job" >&2
      exit 1
    }
    write_launch_plist
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_PLIST" 2>/dev/null || {
      echo "chrome-agent: could not bootstrap ${LAUNCH_LABEL}" >&2
      exit 1
    }
    for _ in $(seq 1 30); do
      if endpoint_up; then
        # Chrome may briefly expose CDP before its first launchd-managed
        # process hands off and exits. Require the endpoint to survive that
        # handoff so callers never receive a false ready.
        sleep 2
        if endpoint_up; then
          echo "chrome-agent: ready"
          exit 0
        fi
      fi
      sleep 0.5
    done
    remove_launch_job || true
    echo "chrome-agent: launched, but CDP never came up; see ${PROFILE_DIR}/chrome.log" >&2
    exit 1
    ;;

  stop)
    remove_launch_job || true
    if endpoint_up; then
      curl -fsS --connect-timeout 1 "${CDP_URL}/json/close" >/dev/null 2>&1 || true
    fi
    if [ -f "$PID_FILE" ]; then
      pid="$(cat "$PID_FILE")"
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
      fi
      rm -f "$PID_FILE"
    fi
    pkill -f "Google Chrome.*--user-data-dir=${PROFILE_DIR}" 2>/dev/null || true
    for _ in $(seq 1 20); do
      if ! launch_job_loaded && ! endpoint_up; then
        echo "chrome-agent: stopped"
        exit 0
      fi
      sleep 0.1
    done
    echo "chrome-agent: failed to stop launchd job or CDP endpoint" >&2
    exit 1
    ;;

  *)
    echo "chrome-agent: unknown command: $CMD" >&2
    usage >&2
    exit 64
    ;;
esac
